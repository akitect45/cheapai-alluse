# Compiled Rust build outputs & release distributions
/target/
/dist/
/out/
/release/
/release-assets/

# Never allow binaries, installers, shared libraries, debug symbols, or archives
*.exe
*.dll
*.pdb
*.so
*.dylib
*.a
*.lib
*.msi
*.dmg
*.pkg
*.AppImage
*.deb
*.rpm
*.run
*.pak
*.zip
*.tar.gz
*.tgz
*.7z

# Node & local runtime state (contains API keys, Vault DB, snapshots)
/node_modules/
/data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.key
*.pem
*.pfx
*.p12
.env
.env.*

# Internal documentation, architecture notes & agent workspaces (keep only root /README.md)
/docs/
docs/
/*.md
!/README.md
!/LICENSE
/ARCHITECTURE.md
/AGENTS.md
/CLAUDE.md
/GEMINI.md
/CURSOR.md
/Working*.md
/TODO*.md
/NOTES*.md
/CHANGELOG*.md
/packaging/
/.agents/
/.claude/
/.cursor/
/.omx/
/.vscode/
/.idea/

# OS / Editor / Temp metadata
.DS_Store
Thumbs.db
*.swp
*.log
*.tmp
*.bak
*.old
*.before-*
